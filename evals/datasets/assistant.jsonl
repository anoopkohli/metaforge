# Stage-7 assistant golden set: a person (tenant + job title, first such person in the directory)
# asks a question; replay is the recorded action sequence, generated by running the real tools.
# expected.must_contain phrases must appear in the answer; expected.proposals lists proposal kinds.
{"id": "fjord-manager-revenue-and-policy", "tags": ["fjord", "manager", "multi-tool"], "input": {"tenant": "fjord", "title": "Operations Manager", "question": "Which pickup zone brings in the most fare revenue, and what does our fare policy say about airport pickups?", "replay": [{"tool": "query_data", "args": {"query": {"object": "ride", "group_by": "pickup_zone", "aggregate": {"fn": "sum", "field": "fare"}, "order_by": {"field": "value", "desc": true}, "limit": 3}}}, {"tool": "search_documents", "args": {"query": "airport pickup access fee"}}, {"tool": "finish", "args": {"answer": "Suburbs brings in the most fare revenue (1704.20 dollars). Airport pickups add a 5 dollar access fee.", "sources": ["query:1", "fare_policy#1"]}}]}, "expected": {"must_contain": ["Suburbs", ["5 dollar", "$5"]], "proposals": []}}
{"id": "fjord-driver-own-rides", "tags": ["fjord", "staff", "row-scope"], "input": {"tenant": "fjord", "title": "Driver", "question": "How many rides have I driven, and what is my average rating?", "replay": [{"tool": "query_data", "args": {"query": {"object": "ride", "aggregate": {"fn": "count"}}}}, {"tool": "query_data", "args": {"query": {"object": "ride", "aggregate": {"fn": "avg", "field": "rating"}}}}, {"tool": "finish", "args": {"answer": "You have driven 21 rides, with an average rating of 4.38.", "sources": ["query:1", "query:2"]}}]}, "expected": {"must_contain": ["21 rides"], "proposals": []}}
{"id": "fjord-driver-salaries-denied", "tags": ["fjord", "staff", "restricted"], "input": {"tenant": "fjord", "title": "Driver", "question": "What are the salaries of the people in dispatch?", "replay": [{"tool": "query_data", "args": {"query": {"object": "worker", "select": ["full_name", "salary"], "where": [{"field": "department", "op": "=", "value": "Dispatch"}]}}}, {"tool": "finish", "args": {"answer": "Salaries are restricted to managers, so I can't show them to you.", "sources": []}}]}, "expected": {"must_contain": ["restricted"], "proposals": []}}
{"id": "acme-manager-origin-join", "tags": ["acme", "manager", "join"], "input": {"tenant": "acme", "title": "Cafe Manager", "question": "Which coffee origin brings in the most revenue?", "replay": [{"tool": "query_data", "args": {"query": {"object": "product", "select": ["name", "origin"], "limit": 100}}}, {"tool": "query_data", "args": {"query": {"object": "sale", "group_by": "product", "aggregate": {"fn": "sum", "field": "revenue"}, "limit": 100}}}, {"tool": "finish", "args": {"answer": "Colombia brings in the most revenue: 15279.60 dollars across its products.", "sources": ["query:1", "query:2"]}}]}, "expected": {"must_contain": ["Colombia"], "proposals": []}}
{"id": "cinder-associate-own-hours", "tags": ["cinder", "staff", "row-scope"], "input": {"tenant": "cinder", "title": "Associate", "question": "How many hours have I logged in total?", "replay": [{"tool": "query_data", "args": {"query": {"object": "time_entry", "aggregate": {"fn": "sum", "field": "hours"}}}}, {"tool": "finish", "args": {"answer": "You have logged 68.5 hours in total.", "sources": ["query:1"]}}]}, "expected": {"must_contain": ["68.5 hours"], "proposals": []}}
{"id": "gable-receptionist-update", "tags": ["gable", "staff", "write"], "input": {"tenant": "gable", "title": "Receptionist", "question": "Mark the earliest scheduled appointment as completed.", "replay": [{"tool": "query_data", "args": {"query": {"object": "appointment", "select": ["id", "patient", "appointment_date"], "where": [{"field": "status", "op": "=", "value": "scheduled"}], "order_by": {"field": "appointment_date"}, "limit": 1}}}, {"tool": "propose_record_update", "args": {"object": "appointment", "record_id": "appointment-0035", "changes": {"status": "completed"}}}, {"tool": "finish", "args": {"answer": "I've proposed marking Kofi Novak's appointment on 2026-01-05 as completed. Approve it to apply the change.", "sources": ["query:1"]}}]}, "expected": {"must_contain": ["approve"], "proposals": ["record_update"]}}
{"id": "juniper-manager-schema-change", "tags": ["juniper", "manager", "write"], "input": {"tenant": "juniper", "title": "Project Manager", "question": "Add a safety certified yes/no field to workers.", "replay": [{"tool": "propose_schema_change", "args": {"proposal": {"action": "override_object", "target": "worker", "override": {"add_fields": [{"name": "safety_certified", "type": "boolean", "label": "Safety certified"}]}}}}, {"tool": "finish", "args": {"answer": "I've proposed adding a safety_certified field to workers. Approve it to apply.", "sources": []}}]}, "expected": {"must_contain": ["safety_certified"], "proposals": ["schema_change"]}}
