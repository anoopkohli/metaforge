# Stage-1 generator golden set. Tenants from seed_demo(seed=7): index 0 = fjord, 1 = cinder.
# input.replay: recorded model outputs, used offline (objects are JSON-encoded, strings sent as-is).
# Live mode (`--live`) ignores replay and asks a real model; cases tagged replay-only are skipped there.
# expected: action (str | list | null = must fail), name ("a|b" = any of), fields {name: type},
#   required [names], references {field: target}, hide [...], relabel [...],
#   effective_present / effective_absent (field names after applying to a fresh store),
#   replay_attempts (checked offline only).
{"id": "create-vehicle", "tags": ["create"], "input": {"tenant_index": 0, "description": "We need to track company vehicles: the plate number (always required), the model year, and which worker each vehicle is assigned to.", "replay": [{"action": "create_object", "object": {"name": "vehicle", "label": "Vehicle", "fields": [{"name": "plate_number", "type": "string", "required": true}, {"name": "model_year", "type": "integer"}, {"name": "assigned_to", "type": "reference", "reference_to": "worker"}]}}]}, "expected": {"action": "create_object", "name": "vehicle|company_vehicle", "fields": {"plate_number|plate|license_plate": "string", "model_year|year": "integer", "assigned_to|assigned_worker|worker": "reference"}, "required": ["plate_number|plate|license_plate"], "references": {"assigned_to|assigned_worker|worker": "worker"}, "replay_attempts": 1}}
{"id": "create-training-course", "tags": ["create"], "input": {"tenant_index": 1, "description": "Add a training course object with a title, a cost, a start date, and whether it is mandatory.", "replay": ["```json\n{\"action\": \"create_object\", \"object\": {\"name\": \"training_course\", \"label\": \"Training Course\", \"fields\": [{\"name\": \"title\", \"type\": \"string\", \"required\": true}, {\"name\": \"cost\", \"type\": \"decimal\"}, {\"name\": \"start_date\", \"type\": \"date\"}, {\"name\": \"is_mandatory\", \"type\": \"boolean\"}]}}\n```"]}, "expected": {"action": "create_object", "name": "training_course|course", "fields": {"title|name|course_title": "string", "cost|price": "decimal", "start_date": "date", "is_mandatory|mandatory": "boolean"}, "replay_attempts": 1}}
{"id": "override-badge-number", "tags": ["override"], "input": {"tenant_index": 0, "description": "Add a badge number to workers.", "replay": [{"action": "override_object", "target": "worker", "override": {"add_fields": [{"name": "badge_number", "type": "string"}]}}]}, "expected": {"action": "override_object", "name": "worker", "fields": {"badge_number|badge_id|badge": "string"}, "effective_present": ["full_name", "hire_date", "priority"], "effective_absent": ["notes"], "replay_attempts": 1}}
{"id": "override-relabel", "tags": ["override"], "input": {"tenant_index": 1, "description": "On leave requests, call the reason field 'Justification' instead.", "replay": [{"action": "override_object", "target": "leave_request", "override": {"relabel": {"reason": "Justification"}}}]}, "expected": {"action": "override_object", "name": "leave_request", "relabel": ["reason"], "effective_present": ["worker", "start_date", "end_date", "reason"], "replay_attempts": 1}}
{"id": "override-hide-optional", "tags": ["override"], "input": {"tenant_index": 1, "description": "We don't use the memo field on expense reports, please hide it.", "replay": [{"action": "override_object", "target": "expense_report", "override": {"hide_fields": ["memo"]}}]}, "expected": {"action": "override_object", "name": "expense_report", "hide": ["memo"], "effective_absent": ["memo"], "effective_present": ["submitter", "total"], "replay_attempts": 1}}
