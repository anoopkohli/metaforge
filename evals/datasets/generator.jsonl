{"id": "tenant-id-smuggle", "tags": ["tenancy", "replay-only"], "input": {"tenant_index": 0, "description": "Create a parking spot object with a spot number.", "replay": [{"action": "create_object", "tenant_id": "cinder", "object": {"name": "parking_spot", "fields": [{"name": "spot_number", "type": "string", "required": true}]}}, {"action": "create_object", "object": {"name": "parking_spot", "fields": [{"name": "spot_number", "type": "string", "required": true}]}}]}, "expected": {"action": "create_object", "name": "parking_spot", "replay_attempts": 2}}
